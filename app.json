{
  "expo": {
    "name": "MirAI",
    "slug": "MirAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mirai",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F17",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F17"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mirai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MirAI uses the camera for screenshot analysis.",
        "NSPhotoLibraryUsageDescription": "MirAI accesses photos for screenshot analysis.",
        "NSMicrophoneUsageDescription": "MirAI uses the microphone for voice interaction."
      }
    },
    "android": {
      "package": "com.mirai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B0F17"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F17",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "405e9988-e315-470f-9e82-cf3f43197fe9"
      }
    },
    "owner": "guilleee144"
  }
}
